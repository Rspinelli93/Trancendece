flowchart TD
    Need["Assignment needs more content<br/>Topic and level"]
    Retrieve["Find eligible matching examples<br/>Rick"]
    Data[("RAG entries in PostgreSQL<br/>Exclude trials and disabled exercises")]
    Rating["Ratings influence example selection"]
    LLM["LLM produces exercise JSON<br/>Reference solution, compiler code, expected output"]
    Fields["Check required fields and fixed topic"]
    Judge["Insert reference solution<br/>Compile, run, compare output"]
    Pass{"Checks pass?"}
    Reject["Bounded retry or stop<br/>No student penalty"]
    Trial[("Save trial exercise<br/>Not indexed for RAG")]
    Student["Student submits a passing solution"]
    Promote["Activate enabled exercise once"]
    Embed["Create embedding and index<br/>Retry indexing if needed"]
    Admin["Admin-confirmed valid import"]
    Need --> Retrieve
    Data --> Retrieve
    Rating --> Retrieve
    Retrieve --> LLM
    LLM --> Fields
    Fields --> Judge
    Judge --> Pass
    Pass -->|"No"| Reject
    Pass -->|"Yes"| Trial
    Trial --> Student
    Student --> Promote
    Promote --> Embed
    Admin --> Embed
    Embed --> Data
