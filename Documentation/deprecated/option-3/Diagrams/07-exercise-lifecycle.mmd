flowchart TD
    Admin["Admin JSON upload or edit"]
    Generate["Platform LLM generation"]
    Temp["Temporary admin upload"]
    Checks["Required fields + reference solution<br/>Run compiler_code and compare output"]
    Good{"All checks pass?"}
    Failed["Discard failed upload<br/>or retry LLM generation"]
    Origin{"Publication path?"}
    Confirm["Admin confirms passed candidate"]
    Trial["Save trial exercise<br/>Students can receive it, RAG cannot"]
    Student["Real student solution passes<br/>Exercise still enabled"]
    Active["Save or activate exercise"]
    Index["Index for RAG<br/>Pending until indexing succeeds"]
    Feedback["Ratings and reports<br/>Per student and exercise"]
    Review["Needs attention flag<br/>Visible in exercise list"]
    Disable["Admin action or configured threshold<br/>Disable exercise"]
    Retain["Keep student history<br/>Block new scoring and RAG retrieval"]
    Admin --> Temp
    Temp --> Checks
    Generate --> Checks
    Checks --> Good
    Good -->|"No"| Failed
    Good -->|"Yes"| Origin
    Origin -->|"Admin"| Confirm
    Origin -->|"Generated"| Trial
    Trial --> Student
    Student --> Active
    Confirm --> Active
    Active --> Index
    Trial --> Feedback
    Active --> Feedback
    Feedback --> Review
    Review -->|"Admin disables or configured limit reached"| Disable
    Disable --> Retain
    Retain -->|"Upload a corrected replacement"| Admin
