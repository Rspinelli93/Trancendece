flowchart TD
    Student["C code + assignment ID + request ID"]
    Check["Check login and assignment<br/>Reject disabled exercise"]
    Job["Save submission and queue job"]
    Build["Replace {{SOLUTION}} in compiler_code<br/>with the student's code"]
    Runner["Judge0 isolated runner<br/>Garance"]
    Compile["Compile C"]
    Run["Run with time and memory limits"]
    Compare["Compare program output<br/>with expected_output"]
    Result["Passed or a simple failure reason"]
    Save["Save result once<br/>First completion updates progress"]
    Page["Student polls submission result"]
    Failure["Service failure<br/>Retry without learning penalty"]
    Student --> Check
    Check --> Job
    Job --> Build
    Build --> Runner
    Runner --> Compile
    Compile --> Run
    Run --> Compare
    Compile -->|"Compilation error"| Result
    Run -->|"Timeout, memory limit, or crash"| Result
    Compare -->|"Correct or wrong output"| Result
    Runner -->|"Infrastructure problem"| Failure
    Failure --> Save
    Result --> Save
    Save --> Page
